# ============================================================
# Configuración de la aplicación — Proyección de Headcount
# Copiar este archivo a `.env` y completar los valores reales.
# NO versionar el archivo `.env` (ver .gitignore).
# ============================================================

APP_NAME="Proyeccion de Headcount"
APP_ENV=production            # development | production
APP_DEBUG=false              # true solo en desarrollo
APP_URL=http://localhost/ProyeccionHC/public
APP_TIMEZONE=America/Costa_Rica

# --- Base de datos (SQL Server 2019) ---
# El DBA asigna un usuario dedicado (NO usar 'sa').
# Permiso requerido por la app: db_datareader + db_datawriter + EXECUTE (mínimo).
DB_CONNECTION=sqlsrv
DB_HOST=SRV-CARAGRAL\CARAGAL     # servidor\instancia
DB_PORT=1433
DB_DATABASE=ProyeccionHC
DB_USERNAME=usuario_sql
DB_PASSWORD=clave_sql
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Seguridad ---
# Clave para firmar/validar el token CSRF y otros usos internos.
# Generar una cadena larga y aleatoria (p. ej. 64 caracteres).
APP_KEY=CAMBIAR_POR_UNA_CADENA_LARGA_Y_ALEATORIA

# --- Sesión ---
SESSION_NAME=proyeccionhc_session
SESSION_LIFETIME=28800        # segundos (8 horas)

# --- Correo (SMTP - relay interno) ---
MAIL_HOST=webmail.instacredit.com
MAIL_PORT=587
MAIL_SECURITY=starttls        # ninguna | starttls | ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@instacredit.com
MAIL_FROM_NAME="Proyeccion de Headcount"
MAIL_AUTH=true                # true si el relay requiere autenticación
MAIL_PILOTO=                  # si se define, TODOS los correos van a este buzón (modo piloto)
MAIL_ACTIVO=false             # true para habilitar el envío real
